<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#10141C">

    <LinearLayout
        android:id="@+id/connectPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F4F6FA"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="28dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="StylusClient"
            android:textColor="#172033"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Tablet display • Android 7.0+ • Wi-Fi LAN"
            android:textColor="#536078"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/ipInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:hint="IP HP, contoh 192.168.1.10"
            android:inputType="textUri"
            android:singleLine="true"
            android:padding="14dp" />

        <EditText
            android:id="@+id/tokenInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Kode pairing dari StylusHost"
            android:inputType="number"
            android:maxLength="8"
            android:singleLine="true"
            android:padding="14dp" />

        <Button
            android:id="@+id/connectButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Connect" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Masukkan IP dan kode pairing yang tampil di HP."
            android:textColor="#536078"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Palm rejection sederhana: input jari diabaikan; hanya TOOL_TYPE_STYLUS yang diteruskan. Tablet dan HP harus berada di Wi-Fi yang sama."
            android:textColor="#536078"
            android:textSize="13sp" />
    </LinearLayout>

    <id.openai.stylusclient.StylusDisplayView
        android:id="@+id/displayView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone" />
</FrameLayout>
